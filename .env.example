# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
APP_NAME=SportLink

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=sportlink
DB_PASS=change-me
DB_NAME=sportlink
DB_LOGGING=false

# Required: long random strings (e.g. `openssl rand -hex 32`), different from each other
JWT_SECRET=
JWT_RESET_SECRET=

# Web app URL (links in e-mails) and allowed origins, comma separated
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# Optional: without SMTP, e-mails are only logged
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Demo only: reseed the database with fictional data every night
DEMO_MODE=false

# docker-compose only
API_PORT=3000
WEB_PORT=8080
# Address of the API as seen from the visitor's browser
PUBLIC_API_URL=http://localhost:3000/api
# Frontend sources: local folder or git URL
FRONTEND_CONTEXT=../hyperion-connect-frontend
